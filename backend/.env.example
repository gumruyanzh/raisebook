# Raisebook API settings (copy to backend/.env for local development). SPEC §10.
# Every variable is optional locally; staging/production need RAISEBOOK_SESSION_SECRET.

RAISEBOOK_ENV=dev                      # development | test | staging | production (dev/prod accepted)
RAISEBOOK_DATABASE_URL=postgresql://localhost/raisebook_dev
# RAISEBOOK_DB_SCHEMA=                 # search_path override (tests use one schema per run)
# RAISEBOOK_DB_POOL_SIZE=5

RAISEBOOK_PUBLIC_BASE_URL=http://localhost:8000   # this API (a localhost host enables dev_link)
RAISEBOOK_APP_URL=http://localhost:3000           # the web app (magic links point here)
# RAISEBOOK_CORS_ORIGINS=http://127.0.0.1:3000    # extra allowed origins, comma-separated

# Sessions. Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# RAISEBOOK_SESSION_SECRET=
RAISEBOOK_SESSION_COOKIE_SECURE=false  # true in production (HTTPS)
# RAISEBOOK_SESSION_COOKIE_DOMAIN=raisebook.org   # production: shared by web and api hosts
# RAISEBOOK_SESSION_TTL_HOURS=720
# RAISEBOOK_MAGIC_LINK_TTL_MINUTES=15

# Email: log (dev prints sign-in links to stdout) | smtp | memory (tests)
RAISEBOOK_EMAIL_BACKEND=log
# RAISEBOOK_EMAIL_FROM=Raisebook <login@raisebook.org>
# RAISEBOOK_SMTP_HOST=
# RAISEBOOK_SMTP_PORT=587
# RAISEBOOK_SMTP_USERNAME=
# RAISEBOOK_SMTP_PASSWORD=
# RAISEBOOK_SMTP_STARTTLS=true

# Rate limits: postgres (default, works across replicas) | memory | off
RAISEBOOK_RATE_LIMIT_BACKEND=postgres

RAISEBOOK_LOG_LEVEL=INFO
RAISEBOOK_LOG_JSON=false               # true in production

# Tests
# RAISEBOOK_TEST_DATABASE_URL=postgresql://localhost/raisebook_test
# RAISEBOOK_TEST_KEEP_SCHEMA=1
