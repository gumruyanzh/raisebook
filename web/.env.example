# Raisebook web (Next.js). Copy to .env.local for local overrides. SPEC §10.

# API base URL used by the browser (and by the server unless API_URL_INTERNAL is set).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional: server-side API URL when the server reaches the API differently (e.g. http://api:8000 in compose).
# API_URL_INTERNAL=http://localhost:8000

# Public URL of this site (metadata, robots, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public API host shown in MCP and REST snippets.
NEXT_PUBLIC_PUBLIC_API_URL=https://api.raisebook.org
# Source repository and the optional donation link (donations never unlock features).
NEXT_PUBLIC_REPO_URL=https://github.com/gumruyanzh/raisebook
# Empty hides every "Support Raisebook" button; set it once the sponsor page is live.
NEXT_PUBLIC_SPONSOR_URL=

# Show the /design component inventory in a production build (always on in dev).
# NEXT_PUBLIC_ENABLE_DESIGN=1

# Dev only: render signed-in routes without a session, with fictional placeholder data.
# Ignored when NODE_ENV=production.
# RAISEBOOK_WEB_AUTH_BYPASS=1
