# Raisebook production stack (deploy/docker-compose.yml). Copy to deploy/.env and fill in.
# deploy/.env is git-ignored. Never commit real secrets.

# --- Hosts (DNS must point here before `up`; Caddy fetches TLS certificates itself) ---
WEB_HOST=raisebook.org
API_HOST=api.raisebook.org

# --- Postgres ---
POSTGRES_USER=raisebook
POSTGRES_DB=raisebook
# Generate: openssl rand -base64 36 | tr -d '/+=' | cut -c1-40
POSTGRES_PASSWORD=

# --- API ---
RAISEBOOK_ENVIRONMENT=production
# Signs session cookies and CSRF tokens. Generate:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everyone out.
RAISEBOOK_SESSION_SECRET=
# Parent domain shared by the web and API hosts (so the browser sends the session cookie to both).
RAISEBOOK_SESSION_COOKIE_DOMAIN=raisebook.org
# Extra allowed browser origins, comma-separated or a JSON list, e.g. https://staging.example.com
# (the web host is always allowed). Empty or [] means none.
RAISEBOOK_CORS_ORIGINS=[]
RAISEBOOK_DB_POOL_SIZE=5
RAISEBOOK_RATE_LIMIT_BACKEND=postgres
# Anti-abuse cap on companies (workspaces) one person can own; listed emails have no cap.
RAISEBOOK_MAX_WORKSPACES_PER_USER=10
RAISEBOOK_WORKSPACE_LIMIT_EXEMPT_EMAILS=
RAISEBOOK_LOG_LEVEL=INFO

# --- Investor research (optional; off while empty) ---
# Key-encryption key that seals each workspace's OpenRouter key (AES-256-GCM envelope
# encryption). Generate once and store it like a password:
#   python3 -c "import base64,os;print('k1:'+base64.urlsafe_b64encode(os.urandom(32)).decode())"
#   (or: docker compose run --rm api rbctl secrets gen-kek)
# Losing it makes saved OpenRouter keys unreadable; workspace owners then enter them again.
# Rotation: set the new value here, move the old one to RAISEBOOK_SECRETS_KEK_PREVIOUS (with a
# different id, e.g. k2:…), run `rbctl secrets rotate`, then clear _PREVIOUS.
RAISEBOOK_SECRETS_KEK=
RAISEBOOK_SECRETS_KEK_PREVIOUS=
# Parallel research jobs per worker container.
RAISEBOOK_WORKER_CONCURRENCY=4

# --- "Continue with Google" sign-in (optional) ---
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID, type "Web application".
# Authorized redirect URI (exactly): https://API_HOST/v1/auth/google/callback
#   (production: https://api.raisebook.org/v1/auth/google/callback)
# Leave both empty to turn the feature off; the sign-in page then hides the button.
RAISEBOOK_GOOGLE_CLIENT_ID=
RAISEBOOK_GOOGLE_CLIENT_SECRET=

# --- Email (magic links and invites) ---
# Any SMTP provider (Postmark, Amazon SES, Resend, Mailgun…). The sending domain needs the
# provider's SPF/DKIM records; see docs/DEPLOY.md.
RAISEBOOK_EMAIL_BACKEND=smtp
RAISEBOOK_EMAIL_FROM="Raisebook <login@raisebook.org>"
RAISEBOOK_SMTP_HOST=
RAISEBOOK_SMTP_PORT=587
RAISEBOOK_SMTP_USERNAME=
RAISEBOOK_SMTP_PASSWORD=
RAISEBOOK_SMTP_STARTTLS=true

# --- Web (baked into the web image at build time; rebuild after changing) ---
NEXT_PUBLIC_REPO_URL=https://github.com/gumruyanzh/raisebook
NEXT_PUBLIC_SPONSOR_URL=https://github.com/sponsors/gumruyanzh

# --- Backups (deploy/backup.sh) ---
# Local dumps older than this are deleted. The privacy page promises at most 14 days.
BACKUP_DIR=/var/backups/raisebook
BACKUP_RETENTION_DAYS=14
